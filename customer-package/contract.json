{
  "schema_version": "2026-08-30.local-ai-os-customer-package-contract.v1",
  "status": "source_contract_only",
  "product_id": "local-ai-os",
  "purpose": "Define a deterministic customer-package boundary for compatibility, entitlement, release verification, installation, diagnostics, acceptance, rollback and uninstall without representing source tests as production readiness.",
  "interfaces": {
    "compatibility": "python3 scripts/customer-package.py compatibility --facts <compatibility.json>",
    "verify": "python3 scripts/customer-package.py verify --artifacts <dir> --manifest <release.json> --entitlement <entitlement.json> --public-key <trusted-ed25519-public-key.pem>",
    "install": "python3 scripts/customer-package.py install --root <managed-root> --artifacts <dir> --manifest <release.json> --entitlement <entitlement.json> --public-key <trusted-ed25519-public-key.pem>",
    "doctor": "python3 scripts/customer-package.py doctor --root <managed-root>",
    "acceptance": "python3 scripts/customer-package.py acceptance --root <managed-root>",
    "rollback": "python3 scripts/customer-package.py rollback --root <managed-root> --to <installed-version>",
    "uninstall": "python3 scripts/customer-package.py uninstall --root <managed-root>"
  },
  "compatibility": {
    "schema": "2026-08-30.local-ai-os-compatibility.v1",
    "supported_os": ["linux"],
    "supported_arch": ["x86_64", "aarch64"],
    "minimum_free_mb": 1024,
    "unknown_runtime_is_supported": false
  },
  "release_manifest": {
    "schema": "2026-08-30.local-ai-os-release.v1",
    "required": ["product_id", "version", "source_sha", "artifacts", "signing"],
    "artifact_required": ["path", "kind", "sha256", "size"],
    "required_artifact_kinds": ["payload", "sbom", "provenance"],
    "source_sha": "full 40-character lowercase git SHA",
    "artifact_digest": "sha256"
  },
  "signing": {
    "production_status": "signed",
    "production_algorithm": "ed25519",
    "production_requires": ["algorithm", "key_id", "signature_path", "trusted public key supplied outside the untrusted release manifest"],
    "canonical_payload": "UTF-8 JSON of the release manifest with sorted keys and compact separators after removing signing.signature_path",
    "verification_engine": "openssl pkeyutl Ed25519 verification",
    "synthetic_status": "synthetic_test_only",
    "synthetic_is_production_evidence": false,
    "private_signing_keys_in_public_repository": false,
    "rule": "A production manifest is accepted only when its detached Ed25519 signature verifies against an independently trusted public key. Synthetic test evidence is rejected unless an explicit test-only flag is supplied. The public repository never stores a production private signing key."
  },
  "entitlement": {
    "schema": "2026-08-30.local-ai-os-entitlement.v1",
    "required": ["product_id", "entitlement_id", "sku", "release_version", "status"],
    "accepted_status": "active",
    "issuance_authority": "external payment/licensing authority outside this public source repository"
  },
  "managed_install": {
    "ownership_marker": ".local-ai-os-managed-root",
    "version_layout": "releases/<version>",
    "current_pointer": "current.json",
    "uninstall_requires_ownership_marker": true,
    "unmanaged_nonempty_directory_adoption": false,
    "release_version_path_traversal": false,
    "artifact_symlink_escape": false,
    "rollback_requires_existing_verified_version": true,
    "filesystem_root_delete": false
  },
  "public_private_boundary": {
    "public": ["schemas", "CLI interface", "synthetic fixtures", "hash/provenance/SBOM requirements", "signature verification algorithm", "recovery semantics"],
    "customer_only": ["real entitlement", "release artifacts", "release manifest", "detached release signature", "trusted release public key", "customer installation configuration"],
    "private": ["payment secrets", "signing private keys", "provider credentials", "private implementation tooling", "customer data"]
  },
  "truth_boundary": {
    "source_selftest_can_prove": ["compatibility classification", "artifact hash checking", "entitlement binding", "Ed25519 detached-signature verification", "tampered signed manifest rejection", "managed install mechanics", "doctor integrity", "rollback mechanics", "guarded uninstall", "synthetic SBOM/provenance presence"],
    "source_selftest_cannot_prove": ["authority of a future production signing key", "payment", "real entitlement issuance", "customer environment compatibility", "installed runtime health", "verified_live", "customer acceptance", "commercial readiness"]
  }
}
